@model BookingIndexViewModel
@{
    ViewData["Title"] = "Bookings";
}

<section class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Booking control</div>
            <div class="panel-sub">Conflict-safe venue scheduling with unique booking IDs</div>
        </div>
        <a class="primary-button" asp-action="Create">New booking</a>
    </div>
    <div class="panel-body">
        <form method="get" class="toolbar">
            <input type="text" name="search" value="@Model.Search" class="text-input" placeholder="Search by booking ID, event, or venue" />
            <select name="status" class="text-input">
                <option value="">All statuses</option>
                @foreach (var statusOption in Enum.GetValues<BookingStatus>())
                {
                    @if (Model.Status == statusOption)
                    {
                        <option value="@statusOption" selected>@statusOption</option>
                    }
                    else
                    {
                        <option value="@statusOption">@statusOption</option>
                    }
                }
            </select>
            <button type="submit" class="ghost-button">Filter</button>
        </form>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Event</th>
                        <th>Venue</th>
                        <th>Dates</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.BookingReference</td>
                        <td>@booking.EventRecord?.Name</td>
                        <td>@booking.Venue?.Name</td>
                        <td>@booking.StartUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") - @booking.EndUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge @booking.Status.ToString().ToLowerInvariant()">@booking.Status</span></td>
                        <td class="row-actions">
                            <a class="ghost-button" asp-action="Edit" asp-route-id="@booking.Id">Edit</a>
                            <form asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button type="submit" class="danger-button" data-confirm="Delete this booking?">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
