@model EventIndexViewModel
@{
    ViewData["Title"] = "Events";
}

<section class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Event pipeline</div>
            <div class="panel-sub">Events can be loaded before a venue becomes available</div>
        </div>
        <a class="primary-button" asp-action="Create">Add event</a>
    </div>
    <div class="panel-body">
        <form method="get" class="toolbar">
            <input type="text" name="search" value="@Model.Search" class="text-input" placeholder="Search by event or client" />
            <select name="status" class="text-input">
                <option value="">All statuses</option>
                @foreach (var statusOption in Enum.GetValues<EventStatus>())
                {
                    @if (Model.Status == statusOption)
                    {
                        <option value="@statusOption" selected>@statusOption</option>
                    }
                    else
                    {
                        <option value="@statusOption">@statusOption</option>
                    }
                }
            </select>
            <button type="submit" class="ghost-button">Filter</button>
        </form>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Client</th>
                        <th>Dates</th>
                        <th>Guests</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Events)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.OrganizerName</td>
                        <td>@item.RequestedStartUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") - @item.RequestedEndUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.ExpectedGuests</td>
                        <td><span class="badge @item.Status.ToString().ToLowerInvariant()">@item.Status</span></td>
                        <td class="row-actions">
                            <a class="ghost-button" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="danger-button" data-confirm="Delete this event?">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
