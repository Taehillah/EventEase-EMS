@{
    ViewData["Title"] = "Something went wrong";
}

<section class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Unexpected error</div>
            <div class="panel-sub">The request could not be completed.</div>
        </div>
    </div>
    <div class="panel-body">
        <p class="muted-copy">Review the application logs and configuration, then retry the action.</p>
    </div>
</section>
