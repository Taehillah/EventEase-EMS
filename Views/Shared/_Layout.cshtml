@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var userName = User.Identity?.Name ?? "Booking Specialist";
    var initials = string.Concat(userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => part[0])).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventEase</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <div class="bg"></div>
    <canvas id="stars" class="stars"></canvas>

    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-ring-sm">
                    <svg viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" /></svg>
                </div>
                <span class="logo-text">Event<span>Ease</span></span>
            </div>

            <div class="nav-section">
                <div class="nav-label">Main</div>
                <a class="nav-item @(controller == "Dashboard" ? "active" : string.Empty)" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a class="nav-item @(controller == "Bookings" ? "active" : string.Empty)" asp-controller="Bookings" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" /></svg>
                    Bookings
                </a>
                <a class="nav-item @(controller == "Venues" ? "active" : string.Empty)" asp-controller="Venues" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    Venues
                </a>
                <a class="nav-item @(controller == "Events" ? "active" : string.Empty)" asp-controller="Events" asp-action="Index">
                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                    Events
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">Management</div>
                <a class="nav-item @(controller == "Venues" && action == "Create" ? "active" : string.Empty)" asp-controller="Venues" asp-action="Create">
                    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                    Add Venue
                </a>
                <a class="nav-item @(controller == "Events" && action == "Create" ? "active" : string.Empty)" asp-controller="Events" asp-action="Create">
                    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                    Add Event
                </a>
                <a class="nav-item @(controller == "Bookings" && action == "Create" ? "active" : string.Empty)" asp-controller="Bookings" asp-action="Create">
                    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                    New Booking
                </a>
            </div>

            <div class="sidebar-bottom">
                <div class="user-pill">
                    <div class="avatar">@initials</div>
                    <div class="user-info">
                        <div class="user-name">@userName</div>
                        <div class="user-role">Authorised Specialist</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ghost-button">Sign out</button>
                </form>
            </div>
        </aside>

        <main class="main">
            <div class="topbar">
                <div class="topbar-left">
                    <h1>@ViewData["Title"]</h1>
                    <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
                </div>
                <div class="topbar-actions">
                    <a class="ghost-button" asp-controller="Bookings" asp-action="Create">Quick booking</a>
                </div>
            </div>

            @await Html.PartialAsync("_StatusMessage")
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
